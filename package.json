{
  "name": "raleigh-travel",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error .",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.2.0",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tailwindcss": "^1.16.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
