{
  "name": "raleigh-travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --threads=2 .",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --fix --threads=2 .",
    "format": "oxfmt --write --threads=2 .",
    "format:check": "oxfmt --check --threads=2 .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:plugin": "node tools/oxlint/verify-anti-slop.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.85.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.1",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "portless": "0.15.7",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7",
    "vitest": "^5.0.3"
  }
}
