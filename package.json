{
  "name": "raleigh-travel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error .",
    "lint:fix": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity error --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck"
  },
  "dependencies": {
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  }
}
