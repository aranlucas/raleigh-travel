{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/@aranlucas/oxforge/configs/recommended.json",
    "./node_modules/@aranlucas/oxforge/configs/nextjs.json",
    "./node_modules/@aranlucas/oxforge/configs/vitest.json",
    "./node_modules/@aranlucas/oxforge/configs/tailwind.json",
    "./node_modules/@aranlucas/oxforge/configs/type-aware.json"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "react", "jsx-a11y", "nextjs", "import", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "settings": {
    "react": {
      "linkComponents": [
        {
          "name": "Link",
          "linkAttribute": "href"
        }
      ]
    },
    "jsx-a11y": {
      "components": {
        "Link": "a"
      }
    },
    "tailwindcss": {
      "entryPoint": "src/app/globals.css"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "build/**",
    "coverage/**",
    "next-env.d.ts",
    "node_modules/**",
    "dist/**",
    ".snapshot*",
    "_site/**",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/.next/**",
    "**/.expo/**",
    "**/.vercel/**",
    "**/.agent/**",
    "**/.agents/**",
    "**/.claude/**",
    "**/.codex/**",
    "**/.continue/**",
    "**/.cursor/**",
    "**/.gemini/**",
    "**/.opencode/**",
    "**/.pi/**",
    "**/.roo/**",
    "**/.windsurf/**"
  ],
  "options": {
    "typeAware": true
  },
  "rules": {
    "eslint/eqeqeq": ["error", "always"],
    "eslint/no-unused-vars": "error",
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "allow": ["ReactNode", "KeyboardEvent", "Promise"]
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "react/only-export-components": [
      "error",
      {
        "allowExportNames": ["metadata", "generateMetadata", "generateStaticParams"]
      }
    ]
  }
}
